# Environment Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to git!

# Payment Configuration
PAYMENT_PHONE=01931634792
BKASH_APP_PACKAGE=com.bKash.customerapp
NAGAD_APP_PACKAGE=com.konasl.nagad

# Server Configuration
PORT=3000
NODE_ENV=production

# Security
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Frontend Configuration
FRONTEND_URL=https://nuruzzaman-nuru.github.io/meatapp/

# Database Configuration (optional, for transaction history)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meatapp
DB_USER=meatapp_user
DB_PASSWORD=secure_password_here

# Payment Gateway API Keys (optional, for direct integration)
BKASH_API_KEY=your_bkash_api_key_here
BKASH_API_SECRET=your_bkash_api_secret_here
NAGAD_API_KEY=your_nagad_api_key_here
NAGAD_API_SECRET=your_nagad_api_secret_here

# Logging
LOG_LEVEL=info
LOG_FILE=server.log

# Monitoring (optional)
SENTRY_DSN=your_sentry_dsn_for_error_tracking